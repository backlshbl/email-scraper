# Copy this file to .env only if your shell tooling loads dotenv files.
# The application itself reads credentials from the process environment.
# Put keys in priority order. The scraper starts with the first key and only
# moves forward when that key is rejected, rate-limited, or out of credits.
# Example: HUNTER_API_KEYS=["hunter-key-1","hunter-key-2"]
HUNTER_API_KEYS=[]
BREVO_API_KEY=
BREVO_LIST_ID=
